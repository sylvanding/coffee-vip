# ========================================
# ☕ 咖啡店会员系统 - 环境变量配置
# ========================================
# 
# 使用说明：
# 1. 复制此文件为 .env 或 .env.local
#    命令：cp env.example .env
# 2. 填写下方的 Supabase 配置信息
# 3. 重启开发服务器（如果正在运行）
# 
# ⚠️ 重要：.env 文件包含敏感信息，不要提交到 Git
# ========================================

# -------------------------------------
# Supabase 配置
# -------------------------------------
# 从 https://supabase.com/dashboard 获取这些值
# 路径：你的项目 → Settings → API

# Supabase 项目 URL
# 格式：https://your-project-ref.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase 匿名密钥（anon public key）
# 这是公开密钥，可以安全地在前端使用
# 格式：eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -------------------------------------
# 配置示例（请替换为你的实际值）
# -------------------------------------
# VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFiY2RlZmdoaWprbG1ub3AiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYyMzg4OTc0MCwiZXhwIjoxOTM5NDY1NzQwfQ.example_signature

# -------------------------------------
# ⚠️ 部署到 Netlify 时
# -------------------------------------
# 需要在 Netlify Dashboard 中设置相同的环境变量：
# Site settings → Environment variables → Add a variable
# 
# 变量名和值必须与本文件中的完全一致
# 修改后需要重新部署才能生效
